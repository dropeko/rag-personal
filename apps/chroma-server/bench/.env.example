# URL do servidor ChromaDB (mesmo apontado pelo db-backend)
CHROMA_URL=http://localhost:8000

# Coleção fonte (produção)
SOURCE_COLLECTION=report_texts

# Credencial OpenAI (necessária para v2/v3/v4)
OPENAI_API_KEY=sk-...

# Batch size de embedding para prepare.py (OpenAI aceita até ~2048 itens/request,
# mas vale o limite de 8191 tokens *somados* — 64 é seguro p/ chunks de ~400 tok)
EMBED_BATCH_SIZE=64

# Quantas vezes repetir cada query para estabilizar latência
QUERY_REPEATS=5

# Top-K para retrieval
TOP_K=10
