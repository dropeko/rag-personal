{
    "name": "@data-platforms/db-backend",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "db-backend",
        "targets": {
            "build": {
                "executor": "nx:run-commands",
                "options": {
                    "command": "webpack-cli build",
                    "args": [
                        "--node-env=production"
                    ],
                    "cwd": "apps/db-backend"
                },
                "configurations": {
                    "development": {
                        "args": [
                            "--node-env=development"
                        ]
                    }
                }
            },
            "prune-lockfile": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "executor": "@nx/js:prune-lockfile",
                "outputs": [
                    "{workspaceRoot}/apps/db-backend/dist/package.json",
                    "{workspaceRoot}/apps/db-backend/dist/package-lock.json"
                ],
                "options": {
                    "buildTarget": "build"
                }
            },
            "copy-workspace-modules": {
                "dependsOn": [
                    "build"
                ],
                "cache": true,
                "outputs": [
                    "{workspaceRoot}/apps/db-backend/dist/workspace_modules"
                ],
                "executor": "@nx/js:copy-workspace-modules",
                "options": {
                    "buildTarget": "build"
                }
            },
            "prune": {
                "dependsOn": [
                    "prune-lockfile",
                    "copy-workspace-modules"
                ],
                "executor": "nx:noop"
            },
            "serve": {
                "continuous": true,
                "executor": "@nx/js:node",
                "defaultConfiguration": "development",
                "dependsOn": [
                    "build"
                ],
                "options": {
                    "buildTarget": "db-backend:build",
                    "runBuildTargetDependencies": false
                },
                "configurations": {
                    "development": {
                        "buildTarget": "db-backend:build:development"
                    },
                    "production": {
                        "buildTarget": "db-backend:build:production"
                    }
                }
            },
            "test": {
                "options": {
                    "passWithNoTests": true
                }
            }
        }
    },
    "dependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@xenova/transformers": "^2.17.2",
        "chromadb": "^3.3.0",
        "docxtemplater": "^3.68.2",
        "docxtemplater-image-module-free": "^1.1.1",
        "dotenv": "^17.3.1",
        "pizzip": "^3.2.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@nestjs/testing": "^11.0.0"
    }
}
