{
    "name": "@data-platforms/wo-backend-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "name": "wo-backend-e2e",
        "implicitDependencies": [
            "wo-backend"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "options": {
                    "jestConfig": "apps/wo-backend-e2e/jest.config.cts",
                    "passWithNoTests": true
                },
                "dependsOn": [
                    "wo-backend:build",
                    "wo-backend:serve"
                ]
            }
        }
    }
}