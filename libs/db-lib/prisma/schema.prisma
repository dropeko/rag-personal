generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model Cliente {
    id       Int     @id @default(autoincrement())
    nome     String  @unique
    email    String?
    telefone String?

    unidades  Unidade[]
    contratos Contrato[]

    @@map("clientes")
}

model Unidade {
    id       Int     @id @default(autoincrement())
    nome     String  @unique
    endereco String?

    clienteId Int
    cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

    @@map("unidades")
}

model Contrato {
    id     Int    @id @default(autoincrement())
    numero String @unique

    clienteId Int
    cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

    sss SS[]

    @@map("contratos")
}

model SS {
    id          Int     @id @default(autoincrement())
    numero      String  @unique
    csc         String? @unique
    solicitante String?

    contratoId Int
    contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

    equipamentos Equipamento[]

    @@map("sss")
}

model Equipamento {
    id       Int     @id @default(autoincrement())
    nome     String
    dados    String?
    operacao String?

    ssId Int
    ss   SS  @relation(fields: [ssId], references: [id], onDelete: Cascade)

    ensaios    Ensaio[]
    relatorios Relatorio[]

    @@map("equipamentos")
}

model Relatorio {
    id               Int    @id @default(autoincrement())
    numero_relatorio String @unique
    revisao          String
    data             String

    elaboracao_nome  String?
    elaboracao_cargo String?
    aprovacao_nome   String?
    aprovacao_cargo  String?

    equipamentoId Int
    equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

    secoes SecaoTexto[]

    created_at DateTime @default(now())

    @@map("relatorios")
}

model SecaoTexto {
    id       Int     @id @default(autoincrement())
    nome     String
    conteudo String?

    relatorioId Int
    relatorio   Relatorio @relation(fields: [relatorioId], references: [id], onDelete: Cascade)

    @@map("secoes_texto")
}

model Ensaio {
    id           Int     @id @default(autoincrement())
    tipo         String
    qnt_amostras Int
    texto        String?

    equipamentoId Int
    equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

    imagens ImagemMetalografia[]

    @@map("ensaios")
}

model ImagemMetalografia {
    id             Int     @id @default(autoincrement())
    caminho_imagem String
    legenda        String?

    ensaioId Int
    ensaio   Ensaio @relation(fields: [ensaioId], references: [id], onDelete: Cascade)

    @@map("imagens_metalografia")
}

enum UserRole {
    USER
    ADMIN
}

model User {
    id                   Int       @id @default(autoincrement())
    firstName            String
    lastName             String
    email                String    @unique
    password             String?
    phone                String?
    position             String?
    role                 UserRole  @default(USER)
    team                 String?
    isConfirmed          Boolean   @default(false)
    confirmationCode     String?
    resetPasswordToken   String?
    resetPasswordExpires DateTime?
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt

    @@map("users")
}
